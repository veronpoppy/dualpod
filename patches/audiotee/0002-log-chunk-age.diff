+  private func recordChunkAge(inputHost: UInt64, framesAfterLast: Double, framesInCallback: Double) {
+    let nowNs = AudioConvertHostTimeToNanos(AudioGetCurrentHostTime())
+    let firstNs = Double(AudioConvertHostTimeToNanos(inputHost))
+    let lastNs = firstNs + (framesInCallback - framesAfterLast - 1) / sourceRate * 1e9
+    let ms = (Double(nowNs) - lastNs) / 1e6
+    ageMin = min(ageMin, ms)
